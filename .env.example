# Copy the relevant blocks into apps/web/.env.local and apps/signaling/.env
# Never commit a real .env file. Production must use https:// and wss://.

# ---------------------------------------------------------------------------
# apps/web — public configuration only (shipped in the browser bundle)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# apps/signaling — server-side configuration
# ---------------------------------------------------------------------------
PORT=3001

# Comma-separated list of exact browser origins allowed to connect.
WEB_ORIGIN=http://localhost:3000

# Comma-separated STUN URLs used for WebRTC candidate discovery.
STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN relay. The web client never sees these values directly; it
# fetches an ICE configuration from GET /ice-servers on this service.
TURN_URLS=

# Preferred: a coturn `static-auth-secret`. The service then mints short-lived
# HMAC credentials per request instead of handing out long-lived ones.
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Fallback only (discouraged): long-lived TURN credentials.
TURN_USERNAME=
TURN_CREDENTIAL=
